{%- comment -%}
  Outputs a product's brand. Uses the vendor unless it is blank or the shop name,
  otherwise the first of the product's collections listed in the
  “Brand collections” theme setting, or else a collection named like the
  start or end of the product title (e.g. “Gel Nettoyant - Kohonjin”).

  Accepts:
  - product {product}
  - field {string} - 'title' (default), 'url' or 'handle'
{%- endcomment -%}
{%- liquid
  assign field = field | default: 'title'
  assign brand = ''
  if product.vendor != blank and product.vendor != shop.name
    if field == 'url'
      assign brand = product.vendor | url_for_vendor
    else
      assign brand = product.vendor
    endif
  elsif settings.kapsule_brand_collections != blank
    assign brand_list = settings.kapsule_brand_collections | strip_newlines | remove: ' ' | prepend: ',' | append: ','
    for brand_collection in product.collections
      assign needle = ',' | append: brand_collection.handle | append: ','
      if brand_list contains needle
        case field
          when 'url'
            assign brand = brand_collection.url
          when 'handle'
            assign brand = brand_collection.handle
          else
            assign brand = brand_collection.title | split: ' : ' | first | split: ' | ' | first | strip
        endcase
        break
      endif
    endfor
    # Brand not listed yet: match a collection named like the start or end of the title ("… - Kohonjin")
    if brand == blank
      assign title_first = product.title | split: ' - ' | first | strip | downcase
      assign title_last = product.title | split: ' - ' | last | strip | downcase
      capture title_key
        render 'kapsule-brand-key', text: title_last
      endcapture
      for brand_collection in product.collections
        assign collection_name = brand_collection.title | strip | downcase
        # Also names written differently: “… - ThreeDaysLove” in “3DAYSLOVE” (handle “exomere-3dayslove”)
        assign handle_match = false
        if product.title contains ' - ' and title_key.size > 2 and brand_collection.products_count <= 80
          capture collection_keys
            render 'kapsule-brand-key', text: brand_collection.handle
            echo '|'
            render 'kapsule-brand-key', text: brand_collection.title
          endcapture
          if collection_keys contains title_key
            assign handle_match = true
          endif
        endif
        if collection_name == title_last or collection_name == title_first or handle_match
          case field
            when 'url'
              assign brand = brand_collection.url
            when 'handle'
              assign brand = brand_collection.handle
            else
              assign brand = brand_collection.title | strip
          endcase
          break
        endif
      endfor
    endif
  endif
  echo brand
-%}
