{%- comment -%}
  Brand list items (<li>): brand collections from the theme settings with a product in stock,
  alphabetical, shown as their logo (collection metafield custom.logo) when set;
  otherwise every vendor with a product in stock in the source collection.

  Accepts:
  - source {collection} - Used when no brand collections are set
{%- endcomment -%}
{%- if settings.kapsule_brand_collections != blank -%}
  {%- comment -%} Brand collections with at least one product in stock, alphabetical {%- endcomment -%}
  {%- liquid
    assign brand_handles = settings.kapsule_brand_collections | strip_newlines | remove: ' ' | split: ','
    assign entries = ''
    for brand_handle in brand_handles
      assign brand_collection = collections[brand_handle]
      if brand_collection == blank or brand_collection.products_count == 0
        continue
      endif
      assign in_stock = false
      for brand_product in brand_collection.products limit: 50
        if brand_product.available
          assign in_stock = true
          break
        endif
      endfor
      unless in_stock
        continue
      endunless
      assign brand_name = brand_collection.title | split: ' : ' | first | split: ' | ' | first | strip
      assign brand_logo = ''
      assign brand_logo_width = ''
      assign logo_image = brand_collection.metafields.custom.logo.value
      if logo_image != blank
        assign brand_logo = logo_image | image_url: height: 80
        assign brand_logo_width = logo_image.aspect_ratio | times: 34 | round
      endif
      assign entries = entries | append: brand_name | append: '§' | append: brand_collection.url | append: '§' | append: brand_logo | append: '§' | append: brand_logo_width | append: '¶'
    endfor
    assign entries = entries | split: '¶' | sort_natural
  -%}
  {%- for entry in entries -%}
    {%- assign parts = entry | split: '§' -%}
    <li>
      <a href="{{ parts[1] }}">
        {%- if parts[2] != blank -%}
          <img src="{{ parts[2] }}" alt="{{ parts[0] | escape }}" width="{{ parts[3] }}" height="34" loading="lazy">
        {%- else -%}
          {{ parts[0] }}
        {%- endif -%}
      </a>
    </li>
  {%- endfor -%}
{%- else -%}
  {%- paginate source.products by 250 -%}
    {%- capture vendor_list -%}{% render 'kapsule-vendor-list', products: source.products %}{%- endcapture -%}
  {%- endpaginate -%}
  {%- assign vendors = vendor_list | split: '|' | uniq | sort_natural -%}
  {%- for vendor in vendors -%}
    <li>
      <a href="{{ vendor | url_for_vendor }}">{{ vendor }}</a>
    </li>
  {%- endfor -%}
{%- endif -%}
