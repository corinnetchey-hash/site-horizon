{%- comment -%}
  One brand of the pop-up store's brand rows: name, status, description, link to the brand's
  website, and its photos (child blocks) in a swipeable rail. Shows empty frames until photos
  are added.
{%- endcomment -%}
{%- liquid
  assign copy_key = 'kapsule.' | append: section.settings.copy_key | append: '.'
  assign block_key = ''
  if block.settings.copy_key != blank
    assign block_key = 'kapsule.' | append: block.settings.copy_key | append: '.'
  endif
  assign rail_id = 'KapsuleBrandRail-' | append: block.id
-%}
{%- capture photos -%}{% content_for 'blocks' %}{%- endcapture -%}
<div class="k-ibrand" data-k-rail {{ block.shopify_attributes }}>
  <div class="k-ibrand__info">
    <h3 class="k-ibrand__name">{% render 'kapsule-t', value: block.settings.name, key: block_key, field: 'name' %}</h3>
    {%- capture status -%}{% render 'kapsule-t', value: block.settings.status, key: block_key, field: 'status' %}{%- endcapture -%}
    {%- if status != blank -%}
      <span class="k-ibrand__status">{{ status }}</span>
    {%- endif -%}
    {%- if block.settings.text != blank -%}
      <p class="k-ibrand__text">{{ block.settings.text }}</p>
    {%- endif -%}
    {%- if block.settings.link != blank -%}
      <a class="k-underline-link k-ibrand__link" href="{{ block.settings.link }}" target="_blank" rel="noopener">
        {%- render 'kapsule-t', value: block.settings.link_label, key: copy_key, field: 'link' -%}
      </a>
    {%- endif -%}
    <div class="k-ibrand__arrows">
      <button type="button" class="k-ibrand__arrow" data-k-rail-prev aria-controls="{{ rail_id }}" aria-label="{% render 'kapsule-t', value: '', key: copy_key, field: 'previous' %}">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M15 18l-6-6 6-6"/></svg>
      </button>
      <button type="button" class="k-ibrand__arrow" data-k-rail-next aria-controls="{{ rail_id }}" aria-label="{% render 'kapsule-t', value: '', key: copy_key, field: 'next' %}">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M9 6l6 6-6 6"/></svg>
      </button>
    </div>
  </div>

  <ul class="k-ibrand__track" id="{{ rail_id }}" data-k-rail-track role="list">
    {%- if photos contains 'k-ibrand__slide' -%}
      {{ photos }}
    {%- else -%}
      {%- for i in (1..4) -%}
        <li class="k-ibrand__slide">
          <span class="k-ibrand__photo k-tint--{{ section.settings.tint }}">
            <span class="k-media__label">{% render 'kapsule-t', value: '', key: copy_key, field: 'photo' %}</span>
          </span>
        </li>
      {%- endfor -%}
    {%- endif -%}
  </ul>
</div>

{% schema %}
{
  "name": "Brand",
  "blocks": [{ "type": "_kapsule-brand-photo" }],
  "settings": [
    { "type": "text", "id": "copy_key", "label": "Default copy key", "info": "e.g. popup.edit_1 — supplies the name and status when left empty, and their English version." },
    { "type": "text", "id": "name", "label": "Name" },
    { "type": "text", "id": "status", "label": "Status", "info": "e.g. “Nouveau cette semaine”." },
    { "type": "textarea", "id": "text", "label": "Description", "info": "A few lines about the brand, shown under its name." },
    { "type": "url", "id": "link", "label": "Brand website", "info": "Shown as “Découvrir la marque”; opens in a new tab." },
    { "type": "text", "id": "link_label", "label": "Link label", "info": "Defaults to “Découvrir la marque”." },
    { "type": "paragraph", "content": "Add the brand's photos as blocks inside this brand, as many as you like." }
  ],
  "presets": [{ "name": "Brand" }]
}
{% endschema %}
