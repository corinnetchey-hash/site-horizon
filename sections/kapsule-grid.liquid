{%- comment -%}
  Heading + a grid of items (audiences, product ranges, steps, reasons…). Each item can carry
  a number or kicker, a title, a text, a small note and an optional photo.
{%- endcomment -%}
<section class="k-container k-section{% if section.settings.end %} k-section--end{% endif %}" id="{{ section.settings.anchor }}">
  <div class="k-pro-head{% if section.settings.center %} k-pro-head--center{% endif %}">
    {%- if section.settings.kicker != blank -%}<div class="k-kicker">{{ section.settings.kicker }}</div>{%- endif -%}
    {%- if section.settings.heading != blank -%}<h2 class="k-h2">{{ section.settings.heading }}</h2>{%- endif -%}
    {%- if section.settings.intro != blank -%}<p class="k-pro-head__intro">{{ section.settings.intro }}</p>{%- endif -%}
  </div>
  <div class="k-pro-grid k-pro-grid--{{ section.settings.columns }} k-pro-grid--{{ section.settings.style }}">
    {%- for block in section.blocks -%}
      <article class="k-pro-item k-pro-item--{{ block.settings.color | default: 'default' }}" {{ block.shopify_attributes }}>
        {%- if section.settings.show_media -%}
          <div class="k-pro-item__media k-tint--{{ block.settings.tint }}">
            {%- liquid
              assign media_image = block.settings.image
              if media_image == blank and block.settings.collection != blank
                assign media_image = block.settings.collection.image | default: block.settings.collection.products.first.featured_image
              endif
            -%}
            {%- if media_image != blank -%}
              {{ media_image | image_url: width: 1000 | image_tag: sizes: '(min-width: 900px) 33vw, 100vw', loading: 'lazy', alt: block.settings.title }}
            {%- else -%}
              <span class="k-media__label">{{ block.settings.photo_label | default: 'PHOTO' }}</span>
            {%- endif -%}
          </div>
        {%- endif -%}
        <div class="k-pro-item__body">
          {%- if block.settings.kicker != blank -%}<div class="k-pro-item__kicker">{{ block.settings.kicker }}</div>{%- endif -%}
          <h3 class="k-pro-item__title">{{ block.settings.title }}</h3>
          {%- if block.settings.text != blank -%}<div class="k-pro-item__text k-rte">{{ block.settings.text }}</div>{%- endif -%}
          {%- if block.settings.tags != blank -%}
            <ul class="k-pro-item__tags" role="list">
              {%- assign tags = block.settings.tags | split: ',' -%}
              {%- for tag in tags -%}
                {%- assign tag = tag | strip -%}
                {%- if tag != blank -%}<li>{{ tag }}</li>{%- endif -%}
              {%- endfor -%}
            </ul>
          {%- endif -%}
          {%- if block.settings.note != blank -%}<p class="k-pro-item__note">{{ block.settings.note }}</p>{%- endif -%}
          {%- if block.settings.button_label != blank and block.settings.button_link != blank -%}
            <a class="k-btn k-btn--dark k-pro-item__button" href="{{ block.settings.button_link }}">{{ block.settings.button_label }}</a>
          {%- endif -%}
        </div>
      </article>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Kapsule grid",
  "settings": [
    { "type": "text", "id": "anchor", "label": "Anchor ID" },
    { "type": "text", "id": "kicker", "label": "Kicker" },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "textarea", "id": "intro", "label": "Introduction" },
    { "type": "checkbox", "id": "center", "label": "Centre the heading", "default": false },
    {
      "type": "select",
      "id": "columns",
      "label": "Columns on desktop",
      "options": [
        { "value": "1", "label": "1 (photo beside the text)" },
        { "value": "2", "label": "2" },
        { "value": "3", "label": "3" },
        { "value": "4", "label": "4" }
      ],
      "default": "3"
    },
    {
      "type": "select",
      "id": "style",
      "label": "Card style",
      "options": [
        { "value": "lines", "label": "Hairlines" },
        { "value": "surface", "label": "Light cards" },
        { "value": "steps", "label": "Numbered steps" }
      ],
      "default": "surface"
    },
    { "type": "checkbox", "id": "show_media", "label": "Show photos", "default": false },
    { "type": "checkbox", "id": "end", "label": "Extra space below", "default": false }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Item",
      "settings": [
        {
          "type": "select",
          "id": "color",
          "label": "Card colour",
          "options": [
            { "value": "default", "label": "Page default" },
            { "value": "white", "label": "White" },
            { "value": "jade", "label": "Jade green" }
          ],
          "default": "default"
        },
        { "type": "text", "id": "kicker", "label": "Number or kicker" },
        { "type": "text", "id": "title", "label": "Title", "default": "Titre" },
        { "type": "richtext", "id": "text", "label": "Text" },
        { "type": "text", "id": "tags", "label": "Tags", "info": "Comma separated, e.g. Instituts, Spas, Hôtels." },
        { "type": "text", "id": "note", "label": "Small note" },
        { "type": "text", "id": "button_label", "label": "Button label" },
        { "type": "url", "id": "button_link", "label": "Button link" },
        { "type": "image_picker", "id": "image", "label": "Photo", "info": "Shown when the section's “Show photos” is on." },
        { "type": "collection", "id": "collection", "label": "Or a collection's photo", "info": "Used when no photo is picked: the collection's image, or its first product's photo." },
        { "type": "text", "id": "photo_label", "label": "Placeholder label" },
        {
          "type": "select",
          "id": "tint",
          "label": "Placeholder tint",
          "options": [
            { "value": "sand", "label": "Sand" },
            { "value": "sage", "label": "Sage" },
            { "value": "rose", "label": "Rose" },
            { "value": "bordeaux", "label": "Bordeaux" }
          ],
          "default": "sand"
        }
      ]
    }
  ],
  "presets": [{ "name": "Kapsule grid", "blocks": [{ "type": "item" }, { "type": "item" }, { "type": "item" }] }]
}
{% endschema %}
