{%- comment -%}
  Opening of the professional (B2B) space: a large title instead of a banner, and one tile per
  offer linking to its part of the page (optional). The "Page look" setting gives the whole
  page content its own Kapsule Pro palette (see .k-pro-mode in kapsule.css).
{%- endcomment -%}
<section class="k-container k-pro-intro{% if section.settings.look != 'none' %} k-pro-mode k-pro-mode--{{ section.settings.look }}{% endif %}{% if section.blocks.size == 0 %} k-pro-intro--solo{% endif %}">
  <div class="k-pro-intro__lead">
    {%- if section.settings.kicker != blank -%}<div class="k-kicker">{{ section.settings.kicker }}</div>{%- endif -%}
    <h1 class="k-pro-intro__title">{{ section.settings.heading }}</h1>
    {%- if section.settings.text != blank -%}<p class="k-pro-intro__text">{{ section.settings.text }}</p>{%- endif -%}
  </div>
  {%- if section.blocks.size > 0 -%}
  <nav class="k-pro-intro__offers" aria-label="{{ section.settings.heading | escape }}">
    {%- for block in section.blocks -%}
      <a class="k-pro-intro__offer" href="{{ block.settings.link }}" {{ block.shopify_attributes }}>
        <span class="k-pro-intro__num">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
        <span class="k-pro-intro__offer-title">{{ block.settings.title }}</span>
        {%- if block.settings.text != blank -%}<span class="k-pro-intro__offer-text">{{ block.settings.text }}</span>{%- endif -%}
        <span class="k-pro-intro__arrow" aria-hidden="true">→</span>
      </a>
    {%- endfor -%}
  </nav>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Kapsule pro intro",
  "settings": [
    {
      "type": "select",
      "id": "look",
      "label": "Page look",
      "options": [
        { "value": "stone", "label": "Warm stone" },
        { "value": "dark", "label": "Dark" },
        { "value": "none", "label": "Same as the rest of the site" }
      ],
      "default": "stone"
    },
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "KAPSULE PRO" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Espace professionnels" },
    { "type": "textarea", "id": "text", "label": "Text" }
  ],
  "blocks": [
    {
      "type": "offer",
      "name": "Offer",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Offre" },
        { "type": "text", "id": "text", "label": "One line" },
        { "type": "url", "id": "link", "label": "Link", "info": "e.g. /pages/professionnels#formation" }
      ]
    }
  ],
  "presets": [{ "name": "Kapsule pro intro" }]
}
{% endschema %}
