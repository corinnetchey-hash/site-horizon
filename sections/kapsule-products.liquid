{%- liquid
  assign copy_key = 'kapsule.' | append: section.settings.copy_key | append: '.'
  assign source = section.settings.collection
  if source == blank
    assign source = collections['all']
  endif
  assign excluded = section.settings.exclude | map: 'handle' | join: ','
  assign excluded = ',' | append: excluded | append: ','
  assign shown = 0
-%}
<div class="k-container k-section">
  <div class="k-head-row">
    <h2 class="k-h2">{% render 'kapsule-t', value: section.settings.heading, key: copy_key, field: 'heading' %}</h2>
    <a class="k-underline-link" href="{{ source.url }}">{{ 'kapsule.general.view_all' | t }}</a>
  </div>
  <div class="k-grid k-grid--home">
    {%- for product in source.products offset: section.settings.offset -%}
      {%- assign needle = ',' | append: product.handle | append: ',' -%}
      {%- if excluded contains needle -%}{%- continue -%}{%- endif -%}
      {% render 'kapsule-card', product: product, style: 'home', show_concerns: true %}
      {%- assign shown = shown | plus: 1 -%}
      {%- if shown >= section.settings.limit -%}{%- break -%}{%- endif -%}
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Kapsule product grid",
  "settings": [
    { "type": "text", "id": "copy_key", "label": "Default copy key", "default": "home.bestsellers" },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "collection", "id": "collection", "label": "Collection", "info": "Defaults to all products." },
    {
      "type": "range",
      "id": "limit",
      "label": "Products on desktop",
      "info": "Mobile always shows the first 4.",
      "min": 4,
      "max": 16,
      "step": 4,
      "default": 4
    },
    {
      "type": "range",
      "id": "offset",
      "label": "Skip the first products",
      "info": "Skips the first products of the collection.",
      "min": 0,
      "max": 12,
      "step": 1,
      "default": 0
    },
    {
      "type": "product_list",
      "id": "exclude",
      "label": "Products to leave out",
      "info": "Pick the hero's products here so they are not shown twice.",
      "limit": 12
    }
  ],
  "presets": [{ "name": "Kapsule product grid" }]
}
{% endschema %}
