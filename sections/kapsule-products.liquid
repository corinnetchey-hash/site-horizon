{%- liquid
  assign copy_key = 'kapsule.' | append: section.settings.copy_key | append: '.'
  assign source = section.settings.collection
  if source == blank
    assign source = collections['all']
  endif
-%}
<div class="k-container k-section">
  <div class="k-head-row">
    <h2 class="k-h2">{% render 'kapsule-t', value: section.settings.heading, key: copy_key, field: 'heading' %}</h2>
    <a class="k-underline-link" href="{{ source.url }}">{{ 'kapsule.general.view_all' | t }}</a>
  </div>
  <div class="k-grid k-grid--home">
    {%- for product in source.products limit: section.settings.limit, offset: section.settings.offset -%}
      {% render 'kapsule-card', product: product, style: 'home', show_concerns: true %}
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Kapsule product grid",
  "settings": [
    { "type": "text", "id": "copy_key", "label": "Default copy key", "default": "home.bestsellers" },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "collection", "id": "collection", "label": "Collection", "info": "Defaults to all products." },
    {
      "type": "range",
      "id": "limit",
      "label": "Products on desktop",
      "info": "Mobile always shows the first 4.",
      "min": 4,
      "max": 16,
      "step": 4,
      "default": 4
    },
    {
      "type": "range",
      "id": "offset",
      "label": "Skip the first products",
      "info": "Use 4 to avoid repeating the products shown in the hero.",
      "min": 0,
      "max": 12,
      "step": 1,
      "default": 0
    }
  ],
  "presets": [{ "name": "Kapsule product grid" }]
}
{% endschema %}
