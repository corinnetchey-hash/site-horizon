<div class="k-container k-section">
  <div class="k-duo k-duo--{{ section.settings.layout }}{% if section.settings.layout == 'joined' %} k-duo--{{ section.settings.style }}{% endif %}">
    {%- for block in section.blocks -%}
      <div
        class="k-duo__col{% if section.settings.layout == 'separate' %} k-duo--{{ block.settings.style }}{% endif %}"
        {{ block.shopify_attributes }}
      >
        {%- liquid
          assign k = 'kapsule.' | append: block.settings.copy_key | append: '.'
          capture kicker
            render 'kapsule-t', value: block.settings.kicker, key: k, field: 'kicker'
          endcapture
          capture heading
            render 'kapsule-t', value: block.settings.heading, key: k, field: 'heading'
          endcapture
          capture quote
            render 'kapsule-t', value: block.settings.quote, key: k, field: 'quote'
          endcapture
          capture text
            render 'kapsule-t', value: block.settings.text, key: k, field: 'text_html'
          endcapture
          capture link_label
            render 'kapsule-t', value: block.settings.link_label, key: k, field: 'link_label'
          endcapture
          assign light_button = false
          if section.settings.layout == 'separate' and block.settings.style == 'bordeaux'
            assign light_button = true
          elsif section.settings.layout == 'joined' and section.settings.style == 'bordeaux'
            assign light_button = true
          endif
        -%}
        {%- if kicker != blank -%}
          <div class="k-kicker">{{ kicker }}</div>
        {%- endif -%}
        {%- if heading != blank -%}
          <h2 class="k-h2 k-duo__heading">{{ heading }}</h2>
        {%- endif -%}
        {%- if quote != blank -%}
          <blockquote class="k-duo__quote">{{ quote }}</blockquote>
        {%- endif -%}
        {%- if text != blank -%}
          <div class="k-duo__body k-rte">{{ text }}</div>
        {%- endif -%}
        {%- if link_label != blank and block.settings.link != blank -%}
          <a
            class="k-btn {% if light_button %}k-btn--light{% else %}k-btn--dark{% endif %} k-duo__button"
            href="{{ block.settings.link }}"
            {% if block.settings.link contains '://' %}
              target="_blank" rel="noopener"
            {% endif %}
          >
            {{- link_label -}}
          </a>
        {%- endif -%}
      </div>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Kapsule two columns",
  "settings": [
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        { "value": "separate", "label": "Two blocks side by side" },
        { "value": "joined", "label": "One block, two columns" }
      ],
      "default": "separate"
    },
    {
      "type": "select",
      "id": "style",
      "label": "Panel style (one block)",
      "options": [
        { "value": "surface", "label": "Light panel" },
        { "value": "white", "label": "White panel" },
        { "value": "bordeaux", "label": "Bordeaux panel" }
      ],
      "default": "surface"
    }
  ],
  "blocks": [
    {
      "type": "column",
      "name": "Column",
      "limit": 2,
      "settings": [
        {
          "type": "select",
          "id": "style",
          "label": "Style (two blocks)",
          "options": [
            { "value": "surface", "label": "Light panel" },
            { "value": "white", "label": "White panel" },
            { "value": "bordeaux", "label": "Bordeaux panel" }
          ],
          "default": "surface"
        },
        { "type": "text", "id": "copy_key", "label": "Default copy key", "info": "Texts left empty come from the theme language files under this key." },
        { "type": "text", "id": "kicker", "label": "Kicker" },
        { "type": "text", "id": "heading", "label": "Heading" },
        { "type": "textarea", "id": "quote", "label": "Quote" },
        { "type": "richtext", "id": "text", "label": "Text" },
        { "type": "text", "id": "link_label", "label": "Button label" },
        { "type": "url", "id": "link", "label": "Button link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Kapsule two columns",
      "blocks": [{ "type": "column" }, { "type": "column" }]
    }
  ]
}
{% endschema %}
