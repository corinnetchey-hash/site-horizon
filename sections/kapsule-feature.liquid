{%- assign copy_key = 'kapsule.' | append: section.settings.copy_key | append: '.' -%}
<div class="k-container k-section">
  <div class="k-feature">
    <div>
      <div class="k-feature__kicker">
        {%- render 'kapsule-t', value: section.settings.kicker, key: copy_key, field: 'kicker' -%}
      </div>
      <h2 class="k-feature__title">
        {%- render 'kapsule-t', value: section.settings.heading, key: copy_key, field: 'heading' -%}
      </h2>
      <p class="k-feature__text">
        {%- render 'kapsule-t', value: section.settings.text, key: copy_key, field: 'text' -%}
      </p>
      <a class="k-btn k-btn--sage" href="{{ section.settings.link }}">
        {%- render 'kapsule-t', value: section.settings.button, key: copy_key, field: 'button' -%}
      </a>
    </div>
    <div class="k-media k-media--glass">
      {%- if section.settings.image != blank -%}
        {{ section.settings.image | image_url: width: 1200 | image_tag: sizes: '(min-width: 700px) 50vw, 100vw', loading: 'lazy' }}
      {%- else -%}
        <span class="k-media__label">{% render 'kapsule-t', value: '', key: copy_key, field: 'photo' %}</span>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Kapsule feature card",
  "settings": [
    { "type": "text", "id": "copy_key", "label": "Default copy key", "default": "home.institut" },
    { "type": "text", "id": "kicker", "label": "Kicker" },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "textarea", "id": "text", "label": "Text" },
    { "type": "text", "id": "button", "label": "Button label" },
    { "type": "url", "id": "link", "label": "Link" },
    { "type": "image_picker", "id": "image", "label": "Image" }
  ],
  "presets": [{ "name": "Kapsule feature card" }]
}
{% endschema %}
