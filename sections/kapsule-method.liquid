{%- comment -%}
  The method in one screen: a photo, the founder's quote, a few key points, and the full story
  folded under "Lire l'histoire de la méthode". Points and chapters read their words from the
  locale copy (copy_key), so the French and English texts stay the same as elsewhere on the site.
  A point shows the chapter's heading and its first sentence unless its own text is filled in.
{%- endcomment -%}
{%- liquid
  assign k = 'kapsule.' | append: section.settings.copy_key | append: '.'
  capture kicker
    render 'kapsule-t', value: section.settings.kicker, key: k, field: 'kicker'
  endcapture
  capture heading
    render 'kapsule-t', value: section.settings.heading, key: k, field: 'heading'
  endcapture
  capture quote
    render 'kapsule-t', value: section.settings.quote, key: k, field: 'quote'
  endcapture
  assign points = section.blocks | where: 'type', 'point'
  assign chapters = section.blocks | where: 'type', 'chapter'
-%}
<section class="k-container k-section" id="{{ section.settings.anchor | default: 'methode' }}">
  <div class="k-method">
    <div class="k-method__media k-tint--{{ section.settings.tint }}">
      {%- if section.settings.image != blank -%}
        {{ section.settings.image | image_url: width: 1200 | image_tag: loading: 'lazy', sizes: '(min-width: 900px) 45vw, 100vw', class: 'k-method__img' }}
      {%- else -%}
        <span class="k-media__label">{% render 'kapsule-t', value: section.settings.photo_label, key: k, field: 'photo' %}</span>
      {%- endif -%}
    </div>

    <div class="k-method__body">
      {%- if kicker != blank -%}<div class="k-kicker">{{ kicker }}</div>{%- endif -%}
      {%- if heading != blank -%}<h2 class="k-h2 k-method__heading">{{ heading }}</h2>{%- endif -%}
      {%- if quote != blank -%}<blockquote class="k-method__quote">{{ quote }}</blockquote>{%- endif -%}

      {%- if points.size > 0 -%}
        <ol class="k-method__points">
          {%- for block in points -%}
            {%- liquid
              assign pk = 'kapsule.' | append: block.settings.copy_key | append: '.'
              capture p_heading
                render 'kapsule-t', value: block.settings.heading, key: pk, field: 'heading'
              endcapture
              capture p_text
                render 'kapsule-t', value: block.settings.text, key: '', field: ''
              endcapture
              if p_text == blank and block.settings.copy_key != blank
                assign full_key = pk | append: 'text_html'
                assign full = full_key | t
                if full contains 'ranslation missing'
                  assign full_key = pk | append: 'text'
                  assign full = full_key | t
                endif
                unless full contains 'ranslation missing'
                  assign p_text = full | replace: '</p>', ' </p>' | replace: '<br>', ' ' | strip_html | strip | split: '. ' | first | append: '.'
                  assign p_text = p_text | replace: '..', '.'
                endunless
              endif
            -%}
            <li class="k-method__point" {{ block.shopify_attributes }}>
              <span class="k-method__num">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
              <div>
                <h3 class="k-method__point-title">{{ p_heading }}</h3>
                {%- if p_text != blank -%}<p class="k-method__point-text">{{ p_text }}</p>{%- endif -%}
              </div>
            </li>
          {%- endfor -%}
        </ol>
      {%- endif -%}

      {%- if chapters.size > 0 -%}
        <details class="k-method__more">
          <summary class="k-method__toggle">
            <span>{% render 'kapsule-t', value: section.settings.more_label, key: k, field: 'more' %}</span>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
          </summary>
          <div class="k-method__chapters">
            {%- for block in chapters -%}
              {%- liquid
                assign ck = 'kapsule.' | append: block.settings.copy_key | append: '.'
                capture c_kicker
                  render 'kapsule-t', value: '', key: ck, field: 'kicker'
                endcapture
                capture c_heading
                  render 'kapsule-t', value: '', key: ck, field: 'heading'
                endcapture
                capture c_quote
                  render 'kapsule-t', value: '', key: ck, field: 'quote'
                endcapture
                capture c_text
                  render 'kapsule-t', value: '', key: ck, field: 'text_html'
                endcapture
                if c_text == blank
                  capture c_text
                    render 'kapsule-t', value: '', key: ck, field: 'text'
                  endcapture
                endif
              -%}
              <article class="k-method__chapter" {{ block.shopify_attributes }}>
                {%- if c_kicker != blank -%}<div class="k-kicker">{{ c_kicker }}</div>{%- endif -%}
                {%- if c_heading != blank -%}<h3 class="k-method__chapter-title">{{ c_heading }}</h3>{%- endif -%}
                {%- if c_quote != blank and block.settings.show_quote -%}<blockquote class="k-method__quote">{{ c_quote }}</blockquote>{%- endif -%}
                {%- if c_text != blank -%}<div class="k-rte">{% if c_text contains '<p' %}{{ c_text }}{% else %}<p>{{ c_text }}</p>{% endif %}</div>{%- endif -%}
              </article>
            {%- endfor -%}
          </div>
        </details>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Kapsule method",
  "settings": [
    { "type": "text", "id": "copy_key", "label": "Copy key", "default": "institut_page.fondatrice", "info": "Supplies the kicker, heading and quote, in French and English." },
    { "type": "text", "id": "anchor", "label": "Anchor ID", "default": "methode" },
    { "type": "image_picker", "id": "image", "label": "Photo" },
    {
      "type": "select",
      "id": "tint",
      "label": "Photo background",
      "options": [
        { "value": "sand", "label": "Sand" },
        { "value": "bordeaux", "label": "Bordeaux" },
        { "value": "sage", "label": "Sage" },
        { "value": "rose", "label": "Rose" }
      ],
      "default": "sand"
    },
    { "type": "text", "id": "photo_label", "label": "Photo placeholder label" },
    { "type": "text", "id": "kicker", "label": "Kicker" },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "textarea", "id": "quote", "label": "Quote" },
    { "type": "text", "id": "more_label", "label": "Read more label" }
  ],
  "blocks": [
    {
      "type": "point",
      "name": "Key point",
      "settings": [
        { "type": "text", "id": "copy_key", "label": "Copy key", "info": "e.g. institut_page.batang — supplies the heading and the first sentence." },
        { "type": "text", "id": "heading", "label": "Heading" },
        { "type": "textarea", "id": "text", "label": "Text", "info": "Leave empty to use the first sentence of the copy." }
      ]
    },
    {
      "type": "chapter",
      "name": "Story chapter",
      "settings": [
        { "type": "text", "id": "copy_key", "label": "Copy key", "info": "e.g. institut_page.technique — the full text shown under Read more." },
        { "type": "checkbox", "id": "show_quote", "label": "Show the chapter's quote", "default": false }
      ]
    }
  ],
  "presets": [{ "name": "Kapsule method" }]
}
{% endschema %}
