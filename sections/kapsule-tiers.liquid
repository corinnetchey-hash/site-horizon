{%- comment -%}
  Membership tiers: side-by-side cards with a name, short pitch, price line, feature list and
  a button; one tier can be highlighted. When "Reserved for validated professionals" is on, only
  signed-in customers with the chosen tag see the tiers; everyone else sees an invitation to
  sign in or to request access.
{%- endcomment -%}
{%- liquid
  assign gate_tag = section.settings.customer_tag | default: 'pro' | strip
  assign unlocked = true
  if section.settings.restricted
    assign unlocked = false
    if customer and customer.tags contains gate_tag
      assign unlocked = true
    endif
  endif
-%}
<section class="k-container k-section" id="{{ section.settings.anchor }}">
  <div class="k-pro-head k-pro-head--center">
    {%- if section.settings.kicker != blank -%}<div class="k-kicker">{{ section.settings.kicker }}</div>{%- endif -%}
    {%- if section.settings.heading != blank -%}<h2 class="k-h2">{{ section.settings.heading }}</h2>{%- endif -%}
    {%- if section.settings.intro != blank -%}<p class="k-pro-head__intro">{{ section.settings.intro }}</p>{%- endif -%}
  </div>
  {%- unless unlocked -%}
    <div class="k-tiers-gate">
      <svg class="k-tiers-gate__icon" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><rect x="4.5" y="10.5" width="15" height="10" rx="2"/><path d="M8 10.5V7.5a4 4 0 0 1 8 0v3"/></svg>
      {%- if customer -%}
        <h3 class="k-tiers-gate__title">{{ 'kapsule.pro_gate.pending_title' | t }}</h3>
        <p class="k-tiers-gate__text">{{ 'kapsule.pro_gate.pending_text' | t }}</p>
      {%- else -%}
        <h3 class="k-tiers-gate__title">{{ 'kapsule.pro_gate.title' | t }}</h3>
        <p class="k-tiers-gate__text">{{ 'kapsule.pro_gate.text' | t }}</p>
        <div class="k-tiers-gate__actions">
          <a class="k-btn k-btn--dark" href="{{ routes.account_login_url }}">{{ 'kapsule.pro_gate.login' | t }}</a>
          {%- if section.settings.request_anchor != blank -%}
            <a class="k-btn k-btn--outline" href="#{{ section.settings.request_anchor }}">{{ 'kapsule.pro_gate.request' | t }}</a>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  {%- else -%}
  <div class="k-tiers">
    {%- for block in section.blocks -%}
      <article class="k-tier{% if block.settings.highlight %} k-tier--highlight{% endif %}" {{ block.shopify_attributes }}>
        {%- if block.settings.badge != blank -%}<span class="k-tier__badge">{{ block.settings.badge }}</span>{%- endif -%}
        <h3 class="k-tier__name">{{ block.settings.name }}</h3>
        {%- if block.settings.tagline != blank -%}<p class="k-tier__tagline">{{ block.settings.tagline }}</p>{%- endif -%}
        {%- if block.settings.price != blank -%}<p class="k-tier__price">{{ block.settings.price }}</p>{%- endif -%}
        {%- if block.settings.features != blank -%}<div class="k-tier__features k-rte">{{ block.settings.features }}</div>{%- endif -%}
        {%- if block.settings.button_label != blank and block.settings.button_link != blank -%}
          <a class="k-btn {% if block.settings.highlight %}k-btn--light{% else %}k-btn--dark{% endif %} k-tier__button" href="{{ block.settings.button_link }}">{{ block.settings.button_label }}</a>
        {%- endif -%}
      </article>
    {%- endfor -%}
  </div>
  {%- if section.settings.note != blank -%}<p class="k-tiers__note">{{ section.settings.note }}</p>{%- endif -%}
  {%- endunless -%}
</section>

{% schema %}
{
  "name": "Kapsule membership tiers",
  "settings": [
    { "type": "text", "id": "anchor", "label": "Anchor ID", "default": "adhesion" },
    { "type": "text", "id": "kicker", "label": "Kicker" },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "textarea", "id": "intro", "label": "Introduction" },
    { "type": "textarea", "id": "note", "label": "Note under the tiers" },
    { "type": "header", "content": "Access" },
    { "type": "checkbox", "id": "restricted", "label": "Reserved for validated professionals", "default": false, "info": "Only signed-in customers with the tag below see the tiers and the note. Add the tag to a customer in Customers once you have checked their business." },
    { "type": "text", "id": "customer_tag", "label": "Customer tag", "default": "pro" },
    { "type": "text", "id": "request_anchor", "label": "Request access button target (anchor)", "default": "demande", "info": "Anchor of the enquiry form on the page. Leave empty to hide the button." }
  ],
  "blocks": [
    {
      "type": "tier",
      "name": "Tier",
      "settings": [
        { "type": "text", "id": "name", "label": "Name", "default": "Adhésion" },
        { "type": "text", "id": "badge", "label": "Badge", "info": "e.g. “Le plus choisi”." },
        { "type": "checkbox", "id": "highlight", "label": "Highlight this tier", "default": false },
        { "type": "text", "id": "tagline", "label": "Short pitch" },
        { "type": "text", "id": "price", "label": "Price line" },
        { "type": "richtext", "id": "features", "label": "What's included", "info": "Use a bulleted list." },
        { "type": "text", "id": "button_label", "label": "Button label" },
        { "type": "url", "id": "button_link", "label": "Button link" }
      ]
    }
  ],
  "presets": [{ "name": "Kapsule membership tiers", "blocks": [{ "type": "tier" }, { "type": "tier" }, { "type": "tier" }] }]
}
{% endschema %}
