{%- comment -%}
  Brand rows (pop-up store): one row per brand, each with a short description, a link to the
  brand's website and a swipeable rail of photos. Brands and their photos are blocks, so any
  number of each can be added from the theme editor.
{%- endcomment -%}
{%- assign copy_key = 'kapsule.' | append: section.settings.copy_key | append: '.' -%}
<section class="k-container k-section k-section--end k-ibrands" id="{{ section.settings.anchor | default: 'marques' }}">
  <div class="k-ibrands__head">
    <div class="k-kicker">{% render 'kapsule-t', value: section.settings.kicker, key: copy_key, field: 'kicker' %}</div>
    <h2 class="k-h2">{% render 'kapsule-t', value: section.settings.heading, key: copy_key, field: 'heading' %}</h2>
    <p class="k-ibrands__intro">{% render 'kapsule-t', value: section.settings.text, key: copy_key, field: 'text' %}</p>
  </div>
  {% content_for 'blocks' %}
</section>

{% schema %}
{
  "name": "Kapsule brand rows",
  "settings": [
    { "type": "text", "id": "copy_key", "label": "Default copy key", "default": "popup.brands" },
    { "type": "text", "id": "anchor", "label": "Anchor ID", "default": "marques" },
    { "type": "text", "id": "kicker", "label": "Kicker" },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "textarea", "id": "text", "label": "Introduction" },
    {
      "type": "select",
      "id": "tint",
      "label": "Photo background",
      "options": [
        { "value": "sand", "label": "Sand" },
        { "value": "rose", "label": "Rose" },
        { "value": "sage", "label": "Sage" },
        { "value": "popup", "label": "Magenta" }
      ],
      "default": "sand"
    }
  ],
  "blocks": [{ "type": "_kapsule-brand" }],
  "presets": [
    {
      "name": "Kapsule brand rows",
      "blocks": [{ "type": "_kapsule-brand" }, { "type": "_kapsule-brand" }, { "type": "_kapsule-brand" }]
    }
  ]
}
{% endschema %}
