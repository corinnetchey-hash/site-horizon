{%- assign copy_key = 'kapsule.' | append: section.settings.copy_key | append: '.' -%}
<div class="k-container k-section">
  <div class="k-head-row">
    <h2 class="k-h2" style="font-size: clamp(22px, 2.6vw, 28px)">
      {%- render 'kapsule-t', value: section.settings.heading, key: copy_key, field: 'heading' -%}
    </h2>
    {%- capture handle -%}{% render 'kapsule-t', value: section.settings.handle, key: copy_key, field: 'handle' %}{%- endcapture -%}
    {%- if section.settings.link != blank -%}
      <a class="k-meta" href="{{ section.settings.link }}" target="_blank" rel="noopener">{{ handle }}</a>
    {%- else -%}
      <span class="k-meta">{{ handle }}</span>
    {%- endif -%}
  </div>
  <div class="k-ugc">
    {%- for block in section.blocks -%}
      {%- if section.settings.link != blank -%}
        <a
          class="k-media k-tint--{{ block.settings.tint }}"
          href="{{ section.settings.link }}"
          target="_blank"
          rel="noopener"
          aria-label="{{ handle | strip }}"
          {{ block.shopify_attributes }}
        >
      {%- else -%}
        <div class="k-media k-tint--{{ block.settings.tint }}" {{ block.shopify_attributes }}>
      {%- endif -%}
        {%- if block.settings.image != blank -%}
          {{ block.settings.image | image_url: width: 600 | image_tag: sizes: '(min-width: 700px) 16vw, 50vw', loading: 'lazy' }}
        {%- else -%}
          <span class="k-media__label">UGC {{ forloop.index }}</span>
        {%- endif -%}
      {%- if section.settings.link != blank -%}</a>{%- else -%}</div>{%- endif -%}
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Kapsule social grid",
  "settings": [
    { "type": "text", "id": "copy_key", "label": "Default copy key", "default": "home.ugc" },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "text", "id": "handle", "label": "Handle" },
    { "type": "url", "id": "link", "label": "Profile link" }
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "Tile",
      "limit": 12,
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        {
          "type": "select",
          "id": "tint",
          "label": "Placeholder tint",
          "options": [
            { "value": "pink", "label": "Pink" },
            { "value": "mint", "label": "Mint" },
            { "value": "sand", "label": "Sand" },
            { "value": "blue", "label": "Blue" },
            { "value": "rose", "label": "Rose" },
            { "value": "teal", "label": "Teal" }
          ],
          "default": "pink"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Kapsule social grid",
      "blocks": [
        { "type": "tile", "settings": { "tint": "pink" } },
        { "type": "tile", "settings": { "tint": "mint" } },
        { "type": "tile", "settings": { "tint": "sand" } },
        { "type": "tile", "settings": { "tint": "blue" } },
        { "type": "tile", "settings": { "tint": "rose" } },
        { "type": "tile", "settings": { "tint": "teal" } }
      ]
    }
  ]
}
{% endschema %}
