{%- assign copy_key = 'kapsule.' | append: section.settings.copy_key | append: '.' -%}
<div class="k-container" style="padding-top: 44px">
  <h2 class="k-h2" style="font-size:30px;margin-bottom:6px">{% render 'kapsule-t', value: section.settings.heading, key: copy_key, field: 'heading' %}</h2>
  <ul class="k-edits">
    {%- for block in section.blocks -%}
      {%- assign block_key = 'kapsule.' | append: block.settings.copy_key | append: '.' -%}
      <li {{ block.shopify_attributes }}>
        <span class="k-edits__name">{% render 'kapsule-t', value: block.settings.name, key: block_key, field: 'name' %}</span>
        <span class="k-edits__status">{% render 'kapsule-t', value: block.settings.status, key: block_key, field: 'status' %}</span>
      </li>
    {%- endfor -%}
  </ul>
</div>

{% schema %}
{
  "name": "Kapsule current edits",
  "settings": [
    { "type": "text", "id": "copy_key", "label": "Default copy key", "default": "popup.edits" },
    { "type": "text", "id": "heading", "label": "Heading" }
  ],
  "blocks": [
    {
      "type": "edit",
      "name": "Edit",
      "settings": [
        { "type": "text", "id": "copy_key", "label": "Default copy key", "info": "e.g. popup.edit_1" },
        { "type": "text", "id": "name", "label": "Name" },
        { "type": "text", "id": "status", "label": "Status" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Kapsule current edits",
      "blocks": [
        { "type": "edit", "settings": { "copy_key": "popup.edit_1" } }
      ]
    }
  ]
}
{% endschema %}
