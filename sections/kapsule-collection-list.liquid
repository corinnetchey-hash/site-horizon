<div class="k-container k-section">
  {%- if section.settings.show_header -%}
    <div class="k-kicker">—— {{ 'kapsule.general.shop' | t | upcase }}</div>
    <h1 class="k-h1 k-h1--shop">{{ section.settings.heading | default: collection.title | default: page_title }}</h1>
    {%- if collection.description != blank -%}
      <div class="k-shop__intro k-rte">{{ collection.description }}</div>
    {%- endif -%}
  {%- elsif section.settings.heading != blank -%}
    <h2 class="k-h2">{{ section.settings.heading }}</h2>
  {%- endif -%}
  <div class="k-tiles-list">
    {%- for block in section.blocks -%}
      {%- assign tile_collection = block.settings.collection -%}
      {%- if tile_collection == blank or tile_collection.products_count == 0 -%}{%- continue -%}{%- endif -%}
      {%- assign tile_image = tile_collection.featured_image | default: tile_collection.products.first.featured_media -%}
      <a class="k-coll-tile" href="{{ tile_collection.url }}" {{ block.shopify_attributes }}>
        <span class="k-coll-tile__media">
          {%- if tile_image -%}
            {{ tile_image | image_url: width: 700 | image_tag: sizes: '(min-width: 1000px) 25vw, 50vw', loading: 'lazy', alt: tile_collection.title }}
          {%- endif -%}
        </span>
        <span class="k-coll-tile__body">
          <span class="k-coll-tile__title">{{ tile_collection.title | split: ' : ' | first | split: ' | ' | first }}</span>
          <span class="k-coll-tile__count">{{ 'kapsule.general.products_count' | t: count: tile_collection.products_count }}</span>
        </span>
      </a>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Kapsule collection tiles",
  "settings": [
    { "type": "checkbox", "id": "show_header", "label": "Show the collection title and description", "default": true },
    { "type": "text", "id": "heading", "label": "Heading" }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "Collection",
      "settings": [{ "type": "collection", "id": "collection", "label": "Collection" }]
    }
  ],
  "presets": [{ "name": "Kapsule collection tiles" }]
}
{% endschema %}
