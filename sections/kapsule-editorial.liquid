{%- assign copy_key = 'kapsule.' | append: section.settings.copy_key | append: '.' -%}
<section class="k-editorial{% if section.settings.flip %} k-editorial--flip{% endif %}" id="{{ section.settings.anchor }}">
  <div class="k-container k-editorial__inner">
    <div class="k-media k-tint--{{ section.settings.tint }}">
      {%- if section.settings.image != blank -%}
        {{ section.settings.image | image_url: width: 1400 | image_tag: sizes: '(min-width: 700px) 50vw, 100vw', loading: 'lazy' }}
      {%- else -%}
        <span class="k-media__label">{% render 'kapsule-t', value: '', key: copy_key, field: 'photo' %}</span>
      {%- endif -%}
    </div>
    <div>
      <div class="k-kicker">{% render 'kapsule-t', value: section.settings.kicker, key: copy_key, field: 'kicker' %}</div>
      <h2 class="k-editorial__title">{% render 'kapsule-t', value: section.settings.heading, key: copy_key, field: 'heading' %}</h2>
      <p class="k-editorial__text">{% render 'kapsule-t', value: section.settings.text, key: copy_key, field: 'text' %}</p>
      {%- if section.settings.link != blank -%}
        <a class="k-underline-link" style="font-size:13.5px;border-bottom-color:rgba(26,23,20,.45)" href="{{ section.settings.link }}">
          {%- render 'kapsule-t', value: section.settings.link_label, key: copy_key, field: 'link' -%}
        </a>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Kapsule editorial row",
  "settings": [
    { "type": "text", "id": "copy_key", "label": "Default copy key", "default": "vision.block_1" },
    { "type": "text", "id": "anchor", "label": "Anchor ID" },
    { "type": "checkbox", "id": "flip", "label": "Image on the right", "default": false },
    { "type": "image_picker", "id": "image", "label": "Image" },
    {
      "type": "select",
      "id": "tint",
      "label": "Placeholder tint",
      "options": [
        { "value": "bordeaux", "label": "Bordeaux" },
        { "value": "sage", "label": "Sage" },
        { "value": "popup", "label": "Magenta" },
        { "value": "sand", "label": "Sand" }
      ],
      "default": "bordeaux"
    },
    { "type": "text", "id": "kicker", "label": "Kicker" },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "textarea", "id": "text", "label": "Text" },
    { "type": "text", "id": "link_label", "label": "Link label" },
    { "type": "url", "id": "link", "label": "Link" }
  ],
  "presets": [{ "name": "Kapsule editorial row" }]
}
{% endschema %}
