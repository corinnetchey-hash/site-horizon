{%- assign copy_key = 'kapsule.' | append: section.settings.copy_key | append: '.' -%}
<div class="k-container" id="reserver" style="padding-top: 38px; padding-bottom: 56px" data-k-booking>
  <h2 class="k-h2" style="font-size:28px">{% render 'kapsule-t', value: section.settings.heading, key: copy_key, field: 'heading' %}</h2>
  <ul class="k-treatments">
    {%- for block in section.blocks -%}
      {%- assign block_key = 'kapsule.' | append: block.settings.copy_key | append: '.' -%}
      {%- capture name -%}{% render 'kapsule-t', value: block.settings.name, key: block_key, field: 'name' %}{%- endcapture -%}
      {%- capture price -%}{% render 'kapsule-t', value: block.settings.price, key: block_key, field: 'price' %}{%- endcapture -%}
      {%- if forloop.index == section.settings.selected -%}
        {%- assign selected_label = name | append: ' — ' | append: price -%}
      {%- endif -%}
      {%- assign treatment_link = block.settings.link | default: section.settings.booking_url -%}
      <li {{ block.shopify_attributes }}>
        {%- if treatment_link != blank -%}
        <a class="k-treatment" href="{{ treatment_link }}" target="_blank" rel="noopener">
        {%- else -%}
        <button
          type="button"
          class="k-treatment"
          data-k-treatment="{{ name | append: ' — ' | append: price | escape }}"
          aria-pressed="{% if forloop.index == section.settings.selected %}true{% else %}false{% endif %}"
        >
        {%- endif -%}
          <span>
            <span class="k-treatment__name" style="display:block">{{ name }}</span>
            <span class="k-treatment__desc" style="display:block">{% render 'kapsule-t', value: block.settings.text, key: block_key, field: 'text' %}</span>
          </span>
          <span class="k-treatment__meta">
            <span class="k-treatment__duration">{% render 'kapsule-t', value: block.settings.duration, key: block_key, field: 'duration' %}</span>
            {%- if price != blank -%}<span class="k-treatment__price">{{ price }}</span>{%- endif -%}
          </span>
        {%- if treatment_link != blank -%}</a>{%- else -%}</button>{%- endif -%}
      </li>
    {%- endfor -%}
  </ul>

  <div class="k-split" style="margin-top: 38px">
    <div class="k-media k-tint--sage-deep">
      {%- if section.settings.image != blank -%}
        {{ section.settings.image | image_url: width: 1200 | image_tag: sizes: '(min-width: 700px) 50vw, 100vw', loading: 'lazy' }}
      {%- else -%}
        <span class="k-media__label">{% render 'kapsule-t', value: '', key: copy_key, field: 'photo' %}</span>
      {%- endif -%}
    </div>
    <div class="k-dark-card">
      <h3 class="k-dark-card__title">{% render 'kapsule-t', value: section.settings.venue, key: copy_key, field: 'venue' %}</h3>
      <div class="k-dark-card__text">
        {% render 'kapsule-t', value: section.settings.address, key: copy_key, field: 'address' %}<br>
        {% render 'kapsule-t', value: section.settings.hours, key: copy_key, field: 'hours' %}
      </div>
      {%- if section.settings.booking_url != blank -%}
        <a class="k-btn k-btn--sage" href="{{ section.settings.booking_url }}" target="_blank" rel="noopener" style="margin-top:18px">
          {%- render 'kapsule-t', value: section.settings.button, key: copy_key, field: 'button' -%}
        </a>
      {%- else -%}
      {%- form 'contact', class: 'k-booking', id: 'KapsuleBooking' -%}
        <div class="k-dark-card__meta" data-k-treatment-selected>
          {{- 'kapsule.institut.treatments.selected' | t: treatment: selected_label -}}
        </div>
        <input type="hidden" name="contact[treatment]" value="{{ selected_label | escape }}" data-k-treatment-field>
        {%- if form.posted_successfully? -%}
          <p class="k-booking__msg">{{ 'kapsule.institut.treatments.sent' | t }}</p>
        {%- else -%}
          <label class="k-visually-hidden" for="KapsuleBookingName">{{ 'kapsule.institut.treatments.name' | t }}</label>
          <input id="KapsuleBookingName" type="text" name="contact[name]" autocomplete="name" placeholder="{{ 'kapsule.institut.treatments.name' | t }}">
          <label class="k-visually-hidden" for="KapsuleBookingEmail">{{ 'kapsule.institut.treatments.email' | t }}</label>
          <input id="KapsuleBookingEmail" type="email" name="contact[email]" autocomplete="email" required placeholder="{{ 'kapsule.institut.treatments.email' | t }}">
          <label class="k-visually-hidden" for="KapsuleBookingPhone">{{ 'kapsule.institut.treatments.phone' | t }}</label>
          <input id="KapsuleBookingPhone" type="tel" name="contact[phone]" autocomplete="tel" placeholder="{{ 'kapsule.institut.treatments.phone' | t }}">
          {%- if form.errors -%}
            <p class="k-booking__msg">{{ 'kapsule.institut.treatments.error' | t }}</p>
          {%- endif -%}
          <button type="submit" class="k-btn k-btn--sage">
            {%- render 'kapsule-t', value: section.settings.button, key: copy_key, field: 'button' -%}
          </button>
        {%- endif -%}
      {%- endform -%}
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Kapsule treatments",
  "settings": [
    {
      "type": "paragraph",
      "content": "Without an online booking link, requests are sent through the store contact form with the selected treatment."
    },
    { "type": "text", "id": "copy_key", "label": "Default copy key", "default": "institut.treatments" },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "range", "id": "selected", "label": "Preselected treatment", "min": 1, "max": 8, "step": 1, "default": 2 },
    { "type": "image_picker", "id": "image", "label": "Treatment-room photo" },
    { "type": "text", "id": "venue", "label": "Venue name" },
    { "type": "text", "id": "address", "label": "Address" },
    { "type": "text", "id": "hours", "label": "Opening hours" },
    { "type": "text", "id": "button", "label": "Button label" },
    {
      "type": "url",
      "id": "booking_url",
      "label": "Online booking link",
      "info": "e.g. your Fresha or Planity page. When set, treatments and the button open it instead of the request form."
    }
  ],
  "blocks": [
    {
      "type": "treatment",
      "name": "Treatment",
      "limit": 8,
      "settings": [
        { "type": "text", "id": "copy_key", "label": "Default copy key", "info": "e.g. institut.treatment_1" },
        { "type": "text", "id": "name", "label": "Name" },
        { "type": "text", "id": "text", "label": "Description" },
        { "type": "text", "id": "duration", "label": "Duration" },
        { "type": "text", "id": "price", "label": "Price", "info": "Leave empty to hide." },
        { "type": "url", "id": "link", "label": "Booking link", "info": "Overrides the section booking link for this treatment." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Kapsule treatments",
      "blocks": [
        { "type": "treatment", "settings": { "copy_key": "institut.treatment_1" } },
        { "type": "treatment", "settings": { "copy_key": "institut.treatment_2" } }
      ]
    }
  ]
}
{% endschema %}
