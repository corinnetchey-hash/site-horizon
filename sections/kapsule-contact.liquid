{%- liquid
  assign k = 'kapsule.' | append: section.settings.copy_key | append: '.'
  capture kicker
    render 'kapsule-t', value: section.settings.kicker, key: k, field: 'kicker'
  endcapture
  capture heading
    render 'kapsule-t', value: section.settings.heading, key: k, field: 'heading'
  endcapture
  capture intro
    render 'kapsule-t', value: section.settings.intro, key: k, field: 'intro'
  endcapture
  capture form_heading
    render 'kapsule-t', value: section.settings.form_heading, key: k, field: 'form_heading'
  endcapture
-%}
<div class="k-container k-section k-contact">
  <header class="k-contact__head">
    {%- if kicker != blank -%}<div class="k-kicker">—— {{ kicker }}</div>{%- endif -%}
    <h1 class="k-h1 k-page__title">{{ heading | default: page.title }}</h1>
    {%- if intro != blank -%}
      <p class="k-contact__intro">{{ intro }}</p>
    {%- endif -%}
  </header>

  {%- if section.blocks.size > 0 -%}
    <div class="k-contact__cards">
      {%- for block in section.blocks -%}
        {%- assign bk = 'kapsule.' | append: block.settings.copy_key | append: '.' -%}
        <div class="k-contact__card" {{ block.shopify_attributes }}>
          {%- capture card_kicker -%}{% render 'kapsule-t', value: block.settings.kicker, key: bk, field: 'kicker' %}{%- endcapture -%}
          {%- capture card_title -%}{% render 'kapsule-t', value: block.settings.title, key: bk, field: 'title' %}{%- endcapture -%}
          {%- if card_kicker != blank -%}
            <div class="k-kicker">{{ card_kicker }}</div>
          {%- endif -%}
          {%- if card_title != blank -%}
            <h2 class="k-contact__card-title">{{ card_title }}</h2>
          {%- endif -%}
          <div class="k-rte k-contact__card-text">{% render 'kapsule-t', value: block.settings.text, key: bk, field: 'text_html' %}</div>
        </div>
      {%- endfor -%}
    </div>
  {%- elsif section.settings.info != blank -%}
    <div class="k-rte k-contact__text">{{ section.settings.info }}</div>
  {%- endif -%}

  {%- if page.content != blank -%}
    <div class="k-rte k-contact__text">{{ page.content }}</div>
  {%- endif -%}

  <div class="k-contact__main{% if section.settings.image != blank %} k-contact__main--image{% endif %}">
  {%- form 'contact', class: 'k-contact__fields', id: 'KapsuleContactForm' -%}
    {%- if form_heading != blank -%}
      <h2 class="k-contact__form-title">{{ form_heading }}</h2>
    {%- endif -%}
    {%- if form.posted_successfully? -%}
      <p class="k-contact__msg" role="status">{{ 'kapsule.contact.sent' | t }}</p>
    {%- endif -%}
    {%- if form.errors -%}
      <p class="k-contact__msg" role="alert">{{ 'kapsule.contact.error' | t }}</p>
    {%- endif -%}
    <div class="k-contact__row">
      <div class="k-contact__field">
        <label for="KapsuleContactName">{{ 'kapsule.contact.name' | t }}</label>
        <input id="KapsuleContactName" type="text" name="contact[name]" autocomplete="name" value="{{ form.name }}">
      </div>
      <div class="k-contact__field">
        <label for="KapsuleContactEmail">{{ 'kapsule.contact.email' | t }}</label>
        <input id="KapsuleContactEmail" type="email" name="contact[email]" autocomplete="email" required value="{{ form.email }}">
      </div>
    </div>
    <div class="k-contact__field">
      <label for="KapsuleContactPhone">{{ 'kapsule.contact.phone' | t }}</label>
      <input id="KapsuleContactPhone" type="tel" name="contact[phone]" autocomplete="tel" value="{{ form.phone }}">
    </div>
    <div class="k-contact__field">
      <label for="KapsuleContactMessage">{{ 'kapsule.contact.message' | t }}</label>
      <textarea id="KapsuleContactMessage" name="contact[body]" rows="6" required>{{ form.body }}</textarea>
    </div>
    <button type="submit" class="k-btn k-btn--bordeaux">{{ 'kapsule.contact.send' | t }}</button>
  {%- endform -%}
  {%- if section.settings.image != blank -%}
    <div class="k-media k-contact__image">
      {{ section.settings.image | image_url: width: 1400 | image_tag: sizes: '(min-width: 900px) 50vw, 100vw', loading: 'lazy' }}
    </div>
  {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Kapsule contact",
  "settings": [
    { "type": "text", "id": "copy_key", "label": "Default copy key", "info": "Texts left empty come from the theme language files under this key." },
    { "type": "text", "id": "kicker", "label": "Kicker" },
    { "type": "text", "id": "heading", "label": "Heading", "info": "Defaults to the page title." },
    { "type": "text", "id": "intro", "label": "Introduction" },
    { "type": "richtext", "id": "info", "label": "Address and opening hours", "info": "Used when the section has no info cards." },
    { "type": "text", "id": "form_heading", "label": "Form heading" },
    { "type": "image_picker", "id": "image", "label": "Image", "info": "Shown beside the form." }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Info card",
      "limit": 4,
      "settings": [
        { "type": "text", "id": "copy_key", "label": "Default copy key" },
        { "type": "text", "id": "kicker", "label": "Kicker" },
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "richtext", "id": "text", "label": "Text" }
      ]
    }
  ],
  "presets": [{ "name": "Kapsule contact" }]
}
{% endschema %}
