{%- liquid
  assign copy_key = 'kapsule.' | append: section.settings.copy_key | append: '.'
  assign source = section.settings.collection
  if source == blank
    assign source = collections['all']
  endif
-%}
<div class="k-container k-section">
  <div class="k-houses">
    <div class="k-kicker" style="text-align:center">
      {%- render 'kapsule-t', value: section.settings.kicker, key: copy_key, field: 'kicker' -%}
    </div>
    <ul class="k-houses__list">
      {%- if section.blocks.size > 0 -%}
        {%- for block in section.blocks -%}
          {%- assign house_url = block.settings.vendor | url_for_vendor -%}
          <li {{ block.shopify_attributes }}>
            <a href="{{ block.settings.link | default: house_url }}">
              {%- if block.settings.logo != blank -%}
                {{ block.settings.logo | image_url: height: 80 | image_tag: alt: block.settings.vendor, height: 34, loading: 'lazy' }}
              {%- else -%}
                {{ block.settings.vendor }}
              {%- endif -%}
            </a>
          </li>
        {%- endfor -%}
      {%- elsif settings.kapsule_brand_collections != blank -%}
        {%- comment -%} Brand collections with at least one product in stock, alphabetical {%- endcomment -%}
        {%- liquid
          assign brand_handles = settings.kapsule_brand_collections | strip_newlines | remove: ' ' | split: ','
          assign entries = ''
          for brand_handle in brand_handles
            assign brand_collection = collections[brand_handle]
            if brand_collection == blank or brand_collection.products_count == 0
              continue
            endif
            assign in_stock = false
            for brand_product in brand_collection.products limit: 50
              if brand_product.available
                assign in_stock = true
                break
              endif
            endfor
            unless in_stock
              continue
            endunless
            assign brand_name = brand_collection.title | split: ' : ' | first | split: ' | ' | first | strip
            assign entries = entries | append: brand_name | append: '§' | append: brand_collection.url | append: '¶'
          endfor
          assign entries = entries | split: '¶' | sort_natural
        -%}
        {%- for entry in entries -%}
          {%- assign parts = entry | split: '§' -%}
          <li><a href="{{ parts[1] }}">{{ parts[0] }}</a></li>
        {%- endfor -%}
      {%- else -%}
        {%- paginate source.products by 250 -%}
          {%- capture vendor_list -%}{% render 'kapsule-vendor-list', products: source.products %}{%- endcapture -%}
        {%- endpaginate -%}
        {%- assign vendors = vendor_list | split: '|' | uniq | sort_natural -%}
        {%- for vendor in vendors -%}
          <li>
            <a href="{{ vendor | url_for_vendor }}">{{ vendor }}</a>
          </li>
        {%- endfor -%}
      {%- endif -%}
    </ul>
  </div>
</div>

{% schema %}
{
  "name": "Kapsule houses",
  "settings": [
    { "type": "text", "id": "copy_key", "label": "Default copy key", "default": "home.houses" },
    { "type": "text", "id": "kicker", "label": "Kicker" },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection",
      "info": "Without blocks, the brand collections from the theme settings are listed; failing that, every vendor with a product in stock in this collection. Defaults to all products."
    }
  ],
  "blocks": [
    {
      "type": "house",
      "name": "House",
      "settings": [
        { "type": "text", "id": "vendor", "label": "Vendor name", "info": "Must match the product vendor exactly." },
        { "type": "image_picker", "id": "logo", "label": "Logo", "info": "Shown instead of the name once supplied." },
        { "type": "url", "id": "link", "label": "Link override" }
      ]
    }
  ],
  "presets": [{ "name": "Kapsule houses" }]
}
{% endschema %}
