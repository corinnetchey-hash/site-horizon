{%- comment -%}
  Training programme (Kapsule Academy — OAK-AN): introduction and modules on the left,
  practical details and a call to action in a dark card on the right.
{%- endcomment -%}
<section class="k-container k-section" id="{{ section.settings.anchor }}">
  <div class="k-academy">
    <div class="k-academy__main">
      {%- if section.settings.kicker != blank -%}<div class="k-kicker">{{ section.settings.kicker }}</div>{%- endif -%}
      <h2 class="k-h2 k-academy__title">{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}<div class="k-academy__text k-rte">{{ section.settings.text }}</div>{%- endif -%}
      {%- if section.settings.image != blank -%}
        <div class="k-academy__media">
          {{ section.settings.image | image_url: width: 1400 | image_tag: sizes: '(min-width: 900px) 55vw, 100vw', loading: 'lazy' }}
        </div>
      {%- endif -%}
      <ol class="k-academy__modules">
        {%- for block in section.blocks -%}
          <li class="k-academy__module" {{ block.shopify_attributes }}>
            <span class="k-academy__num">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
            <div>
              <h3 class="k-academy__module-title">{{ block.settings.title }}</h3>
              {%- if block.settings.text != blank -%}<p class="k-academy__module-text">{{ block.settings.text }}</p>{%- endif -%}
            </div>
          </li>
        {%- endfor -%}
      </ol>
    </div>
    <aside class="k-academy__card">
      {%- if section.settings.card_kicker != blank -%}<div class="k-academy__card-kicker">{{ section.settings.card_kicker }}</div>{%- endif -%}
      {%- if section.settings.card_heading != blank -%}<h3 class="k-academy__card-title">{{ section.settings.card_heading }}</h3>{%- endif -%}
      {%- if section.settings.details != blank -%}<div class="k-academy__details k-rte">{{ section.settings.details }}</div>{%- endif -%}
      {%- if section.settings.price != blank -%}<p class="k-academy__price">{{ section.settings.price }}</p>{%- endif -%}
      {%- if section.settings.button_label != blank and section.settings.button_link != blank -%}
        <a class="k-btn k-btn--light k-academy__button" href="{{ section.settings.button_link }}">{{ section.settings.button_label }}</a>
      {%- endif -%}
    </aside>
  </div>
</section>

{% schema %}
{
  "name": "Kapsule training",
  "settings": [
    { "type": "text", "id": "anchor", "label": "Anchor ID", "default": "formation" },
    { "type": "text", "id": "kicker", "label": "Kicker" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Formation" },
    { "type": "richtext", "id": "text", "label": "Introduction" },
    { "type": "image_picker", "id": "image", "label": "Photo" },
    { "type": "header", "content": "Details card" },
    { "type": "text", "id": "card_kicker", "label": "Card kicker" },
    { "type": "text", "id": "card_heading", "label": "Card heading" },
    { "type": "richtext", "id": "details", "label": "Details", "info": "Use a bulleted list: format, duration, group size, languages…" },
    { "type": "text", "id": "price", "label": "Price line" },
    { "type": "text", "id": "button_label", "label": "Button label" },
    { "type": "url", "id": "button_link", "label": "Button link" }
  ],
  "blocks": [
    {
      "type": "module",
      "name": "Module",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Module" },
        { "type": "textarea", "id": "text", "label": "Text" }
      ]
    }
  ],
  "presets": [{ "name": "Kapsule training", "blocks": [{ "type": "module" }, { "type": "module" }, { "type": "module" }] }]
}
{% endschema %}
