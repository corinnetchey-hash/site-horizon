{%- liquid
  assign locale_root = routes.root_url
  if locale_root == '/'
    assign locale_root = ''
  endif
-%}
{%- assign copy_key = 'kapsule.footer.' -%}
<div class="k-footer">
  <div class="k-footer__grid">
    <div>
      {%- if section.settings.logo != blank -%}
        {{
          section.settings.logo
          | image_url: width: 300
          | image_tag: alt: shop.name, height: 40, width: 135, class: 'k-footer__logo', loading: 'lazy'
        }}
      {%- else -%}
        <img
          class="k-footer__logo"
          src="{{ 'kapsule-wordmark-footer.png' | asset_url }}"
          alt="{{ shop.name }}"
          width="135"
          height="40"
          loading="lazy"
        >
      {%- endif -%}
      <p class="k-footer__about">
        {%- render 'kapsule-t', value: section.settings.about, key: copy_key, field: 'about' -%}
      </p>
    </div>

    {%- for block in section.blocks -%}
      <div {{ block.shopify_attributes }}>
        <h2 class="k-footer__heading">
          {%- render 'kapsule-t', value: block.settings.heading, key: copy_key, field: block.settings.preset -%}
        </h2>
        <ul class="k-footer__links">
          {%- if block.settings.menu.links.size > 0 -%}
            {%- for link in block.settings.menu.links -%}
              <li><a href="{{ link.url }}">{{ link.title }}</a></li>
            {%- endfor -%}
          {%- elsif block.settings.preset == 'services' -%}
            <li><a href="{{ routes.all_products_collection_url }}">{{ 'kapsule.footer.store' | t }}</a></li>
            <li><a href="{{ locale_root }}/pages/institut">{{ 'kapsule.footer.institute' | t }}</a></li>
            <li><a href="{% if pages['reserver-un-soin'].url != blank %}{{ pages['reserver-un-soin'].url }}{% else %}{{ locale_root }}/pages/institut#reserver{% endif %}">{{ 'kapsule.footer.book' | t }}</a></li>
          {%- elsif block.settings.preset == 'infos' -%}
            <li><a href="{{ locale_root }}/pages/notre-vision">{{ 'kapsule.footer.vision' | t }}</a></li>
            <li><a href="{{ locale_root }}/pages/notre-vision#b2b">{{ 'kapsule.footer.trade' | t }}</a></li>
            <li><a href="{{ locale_root }}/pages/contact">{{ 'kapsule.footer.contact' | t }}</a></li>
          {%- else -%}
            {%- if section.settings.instagram != blank -%}
              <li><a href="{{ section.settings.instagram }}" target="_blank" rel="noopener">Instagram</a></li>
            {%- endif -%}
            {%- if section.settings.tiktok != blank -%}
              <li><a href="{{ section.settings.tiktok }}" target="_blank" rel="noopener">TikTok</a></li>
            {%- endif -%}
          {%- endif -%}
        </ul>
      </div>
    {%- endfor -%}
  </div>
  <div class="k-footer__bottom">
    <span>&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}</span>
    <span>{%- render 'kapsule-t', value: section.settings.location, key: copy_key, field: 'location' -%}</span>
  </div>
  <div class="k-stripe" aria-hidden="true"></div>
</div>

{% schema %}
{
  "name": "Kapsule footer",
  "enabled_on": {
    "groups": ["footer"]
  },
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo",
      "info": "Leave empty to use the bundled light Kapsule wordmark."
    },
    {
      "type": "textarea",
      "id": "about",
      "label": "Tagline",
      "info": "Leave empty to use the bilingual default copy."
    },
    {
      "type": "text",
      "id": "location",
      "label": "Location line"
    },
    {
      "type": "url",
      "id": "instagram",
      "label": "Instagram URL"
    },
    {
      "type": "url",
      "id": "tiktok",
      "label": "TikTok URL"
    }
  ],
  "blocks": [
    {
      "type": "column",
      "name": "Link column",
      "limit": 4,
      "settings": [
        {
          "type": "select",
          "id": "preset",
          "label": "Default content",
          "options": [
            { "value": "services", "label": "Services" },
            { "value": "infos", "label": "Informations" },
            { "value": "social", "label": "Suivez-nous" }
          ],
          "default": "services"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Menu",
          "info": "Overrides the default links."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Kapsule footer",
      "blocks": [
        { "type": "column", "settings": { "preset": "services" } },
        { "type": "column", "settings": { "preset": "infos" } },
        { "type": "column", "settings": { "preset": "social" } }
      ]
    }
  ]
}
{% endschema %}
