{%- assign copy_key = 'kapsule.' | append: section.settings.copy_key | append: '.' -%}
<div class="k-container k-fade" style="padding-top: 24px">
  <div class="k-banner{% if section.settings.style == 'popup' %} k-banner--popup{% endif %}{% if section.settings.image != blank %} k-banner--split{% endif %}">
    <div class="k-banner__content">
      <div class="k-banner__kicker">{% render 'kapsule-t', value: section.settings.kicker, key: copy_key, field: 'kicker' %}</div>
      <h1 class="k-banner__title">{% render 'kapsule-t', value: section.settings.heading, key: copy_key, field: 'heading' %}</h1>
      {%- capture text -%}{% render 'kapsule-t', value: section.settings.text, key: copy_key, field: 'text' %}{%- endcapture -%}
      {%- if text != blank -%}
        <p class="k-banner__text">{{ text }}</p>
      {%- endif -%}
      {%- capture body -%}{% render 'kapsule-t', value: section.settings.body, key: copy_key, field: 'body_html' %}{%- endcapture -%}
      {%- if body != blank -%}
        <div class="k-banner__body k-rte">{{ body }}</div>
      {%- endif -%}
      {%- capture button_label -%}{% render 'kapsule-t', value: section.settings.button_label, key: copy_key, field: 'button' %}{%- endcapture -%}
      {%- if button_label != blank and section.settings.button_link != blank -%}
        <a
          class="k-btn k-btn--light k-banner__button"
          href="{{ section.settings.button_link }}"
          {% if section.settings.button_link contains '://' %}
            target="_blank" rel="noopener"
          {% endif %}
        >
          {{- button_label -}}
        </a>
      {%- endif -%}
    </div>
    {%- if section.settings.image != blank -%}
      <div class="k-banner__media">
        {{ section.settings.image | image_url: width: 1400 | image_tag: sizes: '(min-width: 900px) 45vw, 100vw', fetchpriority: 'high' }}
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Kapsule page banner",
  "settings": [
    { "type": "text", "id": "copy_key", "label": "Default copy key", "default": "institut.hero" },
    {
      "type": "select",
      "id": "style",
      "label": "Gradient",
      "options": [
        { "value": "bordeaux", "label": "Bordeaux (Institut)" },
        { "value": "popup", "label": "Magenta (Pop-up)" }
      ],
      "default": "bordeaux"
    },
    { "type": "text", "id": "kicker", "label": "Kicker" },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "textarea", "id": "text", "label": "Text" },
    { "type": "richtext", "id": "body", "label": "Additional text" },
    { "type": "image_picker", "id": "image", "label": "Image", "info": "Shown beside the text." },
    { "type": "text", "id": "button_label", "label": "Button label" },
    { "type": "url", "id": "button_link", "label": "Button link" }
  ],
  "presets": [{ "name": "Kapsule page banner" }]
}
{% endschema %}
