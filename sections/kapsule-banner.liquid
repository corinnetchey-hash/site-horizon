{%- assign copy_key = 'kapsule.' | append: section.settings.copy_key | append: '.' -%}
<div class="k-container k-fade" style="padding-top: 24px">
  <div class="k-banner{% if section.settings.style == 'popup' %} k-banner--popup{% endif %}">
    <div class="k-banner__kicker">{% render 'kapsule-t', value: section.settings.kicker, key: copy_key, field: 'kicker' %}</div>
    <h1 class="k-banner__title">{% render 'kapsule-t', value: section.settings.heading, key: copy_key, field: 'heading' %}</h1>
    {%- capture text -%}{% render 'kapsule-t', value: section.settings.text, key: copy_key, field: 'text' %}{%- endcapture -%}
    {%- if text != blank -%}
      <p class="k-banner__text">{{ text }}</p>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Kapsule page banner",
  "settings": [
    { "type": "text", "id": "copy_key", "label": "Default copy key", "default": "institut.hero" },
    {
      "type": "select",
      "id": "style",
      "label": "Gradient",
      "options": [
        { "value": "bordeaux", "label": "Bordeaux (Institut)" },
        { "value": "popup", "label": "Magenta (Pop-up)" }
      ],
      "default": "bordeaux"
    },
    { "type": "text", "id": "kicker", "label": "Kicker" },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "textarea", "id": "text", "label": "Text" }
  ],
  "presets": [{ "name": "Kapsule page banner" }]
}
{% endschema %}
