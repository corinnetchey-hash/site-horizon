{%- liquid
  assign k = 'kapsule.' | append: section.settings.copy_key | append: '.'
  capture kicker
    render 'kapsule-t', value: section.settings.kicker, key: k, field: 'kicker'
  endcapture
  capture heading
    render 'kapsule-t', value: section.settings.heading, key: k, field: 'heading'
  endcapture
  capture text
    render 'kapsule-t', value: section.settings.text, key: k, field: 'text_html'
  endcapture
  capture button_label
    render 'kapsule-t', value: section.settings.button_label, key: k, field: 'button'
  endcapture
-%}
<div class="k-container k-section{% if section.settings.style != 'plain' %} k-text-wrap{% endif %}">
  <div class="k-text k-text--{{ section.settings.style }} k-text--{{ section.settings.alignment }}">
    {%- if kicker != blank -%}
      <div class="k-kicker">{{ kicker }}</div>
    {%- endif -%}
    {%- if heading != blank -%}
      <h2 class="k-h2 k-text__heading">{{ heading }}</h2>
    {%- endif -%}
    {%- if text != blank -%}
      <div class="k-text__body k-rte">{{ text }}</div>
    {%- endif -%}
    {%- if button_label != blank and section.settings.button_link != blank -%}
      <a
        class="k-btn {% if section.settings.style == 'bordeaux' %}k-btn--light{% else %}k-btn--dark{% endif %} k-text__button"
        href="{{ section.settings.button_link }}"
        {% if section.settings.button_link contains '://' %}
          target="_blank" rel="noopener"
        {% endif %}
      >
        {{- button_label -}}
      </a>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Kapsule text",
  "settings": [
    {
      "type": "select",
      "id": "style",
      "label": "Style",
      "options": [
        { "value": "plain", "label": "Plain" },
        { "value": "surface", "label": "Light panel" },
        { "value": "bordeaux", "label": "Bordeaux panel" }
      ],
      "default": "plain"
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" }
      ],
      "default": "left"
    },
    { "type": "text", "id": "copy_key", "label": "Default copy key", "info": "Texts left empty come from the theme language files under this key." },
    { "type": "text", "id": "kicker", "label": "Kicker" },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "richtext", "id": "text", "label": "Text" },
    { "type": "text", "id": "button_label", "label": "Button label" },
    { "type": "url", "id": "button_link", "label": "Button link" }
  ],
  "presets": [{ "name": "Kapsule text" }]
}
{% endschema %}
