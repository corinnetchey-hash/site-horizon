<div class="k-container k-section{% if section.settings.style != 'plain' %} k-text-wrap{% endif %}">
  <div class="k-text k-text--{{ section.settings.style }} k-text--{{ section.settings.alignment }}">
    {%- if section.settings.kicker != blank -%}
      <div class="k-kicker">{{ section.settings.kicker }}</div>
    {%- endif -%}
    {%- if section.settings.heading != blank -%}
      <h2 class="k-h2 k-text__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}
    {%- if section.settings.text != blank -%}
      <div class="k-text__body k-rte">{{ section.settings.text }}</div>
    {%- endif -%}
    {%- if section.settings.button_label != blank and section.settings.button_link != blank -%}
      <a
        class="k-btn {% if section.settings.style == 'bordeaux' %}k-btn--light{% else %}k-btn--dark{% endif %} k-text__button"
        href="{{ section.settings.button_link }}"
        {% if section.settings.button_link contains '://' %}
          target="_blank" rel="noopener"
        {% endif %}
      >
        {{- section.settings.button_label -}}
      </a>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Kapsule text",
  "settings": [
    {
      "type": "select",
      "id": "style",
      "label": "Style",
      "options": [
        { "value": "plain", "label": "Plain" },
        { "value": "surface", "label": "Light panel" },
        { "value": "bordeaux", "label": "Bordeaux panel" }
      ],
      "default": "plain"
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" }
      ],
      "default": "left"
    },
    { "type": "text", "id": "kicker", "label": "Kicker" },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "richtext", "id": "text", "label": "Text" },
    { "type": "text", "id": "button_label", "label": "Button label" },
    { "type": "url", "id": "button_link", "label": "Button link" }
  ],
  "presets": [{ "name": "Kapsule text" }]
}
{% endschema %}
